---
import Base from "../layouts/Base.astro";
---

<Base page="case" title="Page not found — Nkechi Emechukwu">
  <section class="nf wrap">
    <p class="label"><span class="num">404</span> Broken workflow</p>
    <h1 class="h2">This step <em>didn't trigger.</em></h1>
    <p class="muted">The page you're looking for doesn't exist or has moved.</p>
    <a class="btn" href="/">Back to the homepage <span class="arrow">→</span></a>
  </section>
</Base>

<style>
  .nf {
    min-height: 80svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
    padding-top: var(--header-h);
  }
</style>
