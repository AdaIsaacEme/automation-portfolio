---
import { flagship } from "../data/projects";
const v = flagship.video;
---

<div class="demo">
  <div class="demo__head">
    <h4 class="demo__title">{v.title}</h4>
    <p class="demo__text">{v.text}</p>
    <p class="demo__note">
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
      <span><strong>Disclaimer:</strong> {v.disclaimer}</span>
    </p>
  </div>
  <div class="demo__frame" data-demo data-scale-in>
    <video
      class="demo__video"
      src={v.src}
      poster={v.poster}
      muted
      playsinline
      loop
      preload="none"
      controls
      aria-label="Website integration demo video showing AI qualification engine with mock data"
      data-autoplay-inview
    >
      Your browser does not support the video tag. Please update your browser or use a different device to view this demo.
    </video>
  </div>
</div>

<style>
  .demo__head {
    max-width: 820px;
    margin-bottom: 2rem;
  }

  .demo__title {
    font-family: var(--f-display);
    font-size: var(--fs-h3);
    font-weight: 380;
    line-height: 1.1;
  }

  .demo__text {
    margin-top: 0.8rem;
    color: inherit;
    opacity: 0.85;
  }

  .demo__note {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    margin-top: 1.2rem;
    padding: 1rem 1.2rem;
    border-radius: 14px;
    border-left: 4px solid var(--lilac);
    background: rgb(205 187 221 / 0.1);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .demo__note svg {
    width: 22px;
    flex-shrink: 0;
    color: var(--lilac);
    margin-top: 1px;
  }

  .demo__frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }

  .demo__video {
    width: 100%;
    aspect-ratio: 1600 / 832;
    object-fit: contain;
  }
</style>
