---
import { Image } from "astro:assets";
import { person, mailto, about } from "../data/site";
import { me, shot } from "../lib/images";

// Four tools, two either side of the photo, wired into it.
const nodes = [
  { name: "GoHighLevel", logo: "ghl logo.png", pos: "n1" },
  { name: "Zapier", logo: "zapier logo.png", pos: "n2" },
  { name: "n8n", logo: "n8n logo.png", pos: "n3" },
  { name: "OpenAI", logo: "openapi_logo.png", pos: "n4" },
];
---

<section class="hero" data-hero>
  <div class="hero__grid wrap">
    <div class="hero__copy">
      <p class="label hero__eyebrow" data-hero-fade>
        <span>{person.title}</span>
      </p>

      <h1 class="hero__title">
        <span class="sr-only">{person.name} | {person.title}</span>
        <span class="hero__line" aria-hidden="true" data-hero-line>{person.first}</span>
        <span class="hero__line hero__line--2" aria-hidden="true" data-hero-line><em>{person.last}</em></span>
      </h1>

      <div class="hero__intro" data-hero-fade>
        <h2 class="hero__role">{person.role}</h2>
        <p class="hero__tagline">{person.tagline}</p>
      </div>

      <div class="hero__actions" data-hero-fade>
        <a class="btn" href={mailto} data-magnetic>
          Let's Automate Your Business <span class="arrow">→</span>
        </a>
        <a class="hero__scroll" href="#about">
          <span class="hero__scroll-line" aria-hidden="true"></span> Scroll to explore
        </a>
      </div>
    </div>

    <div class="hero__visual" data-hero-stage>
      <svg class="hero__wires" aria-hidden="true" data-wires></svg>

      <figure class="hero__portrait" data-hero-portrait>
        <div class="hero__portrait-inner crop" style="--z:1.4;--x:0.15;--y:0.25">
          <Image
            src={me.hero}
            alt={`Portrait of ${person.name}`}
            widths={[640, 960, 1400]}
            sizes="(min-width: 900px) 40vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="portrait-grade"
          />
        </div>
      </figure>

      {
        nodes.map((n) => (
          <div class={`hero__node ${n.pos}`} data-node aria-hidden="true">
            <Image src={shot(n.logo)} alt="" width={96} height={96} class="hero__node-img" />
            <span class="hero__node-name">{n.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<div class="ribbon on-dark" aria-label="Results">
  <div class="ribbon__track" data-marquee data-speed="0.6">
    {
      [0, 1].map((copy) => (
        <ul class="ribbon__list" aria-hidden={copy === 1 ? "true" : undefined}>
          {about.results.map((r) => (
            <li>
              <span>{r}</span>
              <span class="ribbon__star" aria-hidden="true">✦</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  /* Phones: photo sits right after the name instead of below everything. */
  @media (max-width: 899px) {
    .hero__grid {
      gap: 1.6rem;
    }

    .hero__copy {
      display: contents;
    }

    .hero__eyebrow { order: 1; }
    .hero__title { order: 2; }
    .hero__visual { order: 3; }
    .hero__intro { order: 4; }
    .hero__actions { order: 5; }

    .hero__eyebrow,
    .hero__intro,
    .hero__actions {
      margin: 0;
    }
  }

  .hero__eyebrow {
    color: var(--mocha);
    margin-bottom: 1.4rem;
  }

  .hero__title {
    font-family: var(--f-display);
    font-size: clamp(3.4rem, 8.4vw, 9.5rem);
    font-weight: 330;
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variation-settings: "SOFT" 40, "WONK" 0, "opsz" 144;
    display: flex;
    flex-direction: column;
  }

  .hero__line {
    display: block;
  }

  .hero__line--2 {
    padding-left: 0.5em;
  }

  .hero__line em {
    font-style: italic;
    font-weight: 280;
    color: var(--plum);
    font-variation-settings: "SOFT" 100, "WONK" 0, "opsz" 144;
  }

  .hero__intro {
    margin-top: clamp(1.8rem, 3vw, 2.6rem);
  }

  .hero__role {
    font-family: var(--f-label);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--plum);
    margin-bottom: 0.5rem;
  }

  .hero__tagline {
    font-family: var(--f-display);
    font-size: clamp(1.2rem, 1.7vw, 1.6rem);
    font-weight: 350;
    line-height: 1.35;
    max-width: 32ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem 2rem;
    margin-top: 2rem;
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--f-label);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mocha);
  }

  .hero__scroll-line {
    position: relative;
    width: 1.5px;
    height: 44px;
    background: var(--cloud);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--plum);
    animation: drip 1.8s var(--ease) infinite;
  }

  @keyframes drip {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(100%);
    }
  }

  /* ── Photo + tool nodes ── */
  .hero__visual {
    position: relative;
    display: grid;
    place-items: center;
    padding-inline: clamp(0rem, 5vw, 5.5rem);
  }

  .hero__portrait {
    position: relative;
    z-index: 2;
    width: min(100%, 420px);
    aspect-ratio: 3 / 4;
  }

  .hero__portrait-inner {
    width: 100%;
    height: 100%;
    border-radius: 999px 999px var(--radius) var(--radius);
    background: var(--khaki);
    box-shadow: 0 30px 60px -24px rgb(40 34 30 / 0.4);
  }

  .hero__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: visible;
    pointer-events: none;
  }

  .hero__wires :global(.wire) {
    fill: none;
    stroke: var(--plum);
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
    opacity: 0.35;
    animation: flow 1.8s linear infinite;
  }

  .hero__wires :global(.packet) {
    fill: var(--plum);
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -20;
    }
  }

  .hero__node {
    display: none;
  }

  @media (min-width: 760px) {
    .hero__node {
      position: absolute;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.85rem 0.35rem 0.35rem;
      border-radius: 999px;
      background: var(--cream);
      border: 1px solid var(--khaki);
      box-shadow: 0 10px 24px -12px rgb(40 34 30 / 0.3);
      font-family: var(--f-label);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .hero__node-img {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: contain;
      background: #fff;
      padding: 3px;
    }

    .n1 { left: 0; top: 16%; }
    .n2 { right: 0; top: 30%; }
    .n3 { left: 2%; top: 66%; }
    .n4 { right: 2%; top: 80%; }
  }

  /* ── Results strip ── */
  .ribbon {
    position: relative;
    z-index: 4;
    padding-block: 1.1rem;
    overflow: hidden;
  }

  .ribbon__track {
    display: flex;
    width: max-content;
  }

  .ribbon__list {
    display: flex;
    flex-shrink: 0;
  }

  .ribbon__list li {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding-right: 1.6rem;
    font-family: var(--f-display);
    font-size: clamp(1.2rem, 2.2vw, 1.9rem);
    font-weight: 350;
    white-space: nowrap;
  }

  .ribbon__list li:nth-child(even) span:first-child {
    font-style: italic;
    color: var(--lilac);
  }

  .ribbon__star {
    color: var(--lilac);
    font-size: 0.7em;
  }
</style>
