<dialog class="lightbox" aria-label="Expanded screenshot" data-lightbox>
  <div class="lightbox__stage">
    <img class="lightbox__img" alt="" data-lightbox-img />
  </div>
  <p class="lightbox__caption" data-lightbox-caption></p>
  <button class="lightbox__btn lightbox__close" type="button" aria-label="Close" data-lightbox-close>×</button>
  <button class="lightbox__btn lightbox__prev" type="button" aria-label="Previous image" data-lightbox-prev>←</button>
  <button class="lightbox__btn lightbox__next" type="button" aria-label="Next image" data-lightbox-next>→</button>
  <p class="lightbox__count" data-lightbox-count></p>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: rgb(28 24 21 / 0.96);
    color: var(--cream);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .lightbox__stage {
    display: grid;
    place-items: center;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(1rem, 6vw, 6rem) 1rem;
    min-height: 0;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
  }

  .lightbox__caption {
    text-align: center;
    padding: 0.5rem 1rem 1.8rem;
    font-family: var(--f-display);
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    font-style: italic;
  }

  .lightbox__btn {
    position: absolute;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgb(255 248 231 / 0.1);
    color: var(--cream);
    font-size: 1.4rem;
    transition: background-color 0.3s, color 0.3s;
  }

  .lightbox__btn:hover {
    background: var(--lilac);
    color: var(--espresso);
  }

  .lightbox__close {
    top: 16px;
    right: 16px;
    font-size: 2rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__prev {
    left: 16px;
  }

  .lightbox__next {
    right: 16px;
  }

  .lightbox__count {
    position: absolute;
    top: 28px;
    left: 24px;
    font-family: var(--f-label);
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    color: var(--cloud);
  }
</style>
