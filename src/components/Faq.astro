---
import { faq, summary } from "../data/seo";
---

<section id="faq" class="faq section" data-section aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <header class="faq__head">
      <p class="label"><span class="num">FAQ</span> Quick answers</p>
      <h2 id="faq-title" class="h2" data-split>Questions, <em>answered</em></h2>
      <p class="faq__summary muted" data-fade-up>{summary}</p>
    </header>

    <div class="faq__list">
      {
        faq.map((f, i) => (
          <details class="qa" open={i === 0}>
            <summary class="qa__q">
              <span>{f.q}</span>
              <span class="qa__icon" aria-hidden="true" />
            </summary>
            <p class="qa__a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--cream);
  }

  .faq__grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1000px) {
    .faq__grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 5rem;
      align-items: start;
    }

    .faq__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .faq__summary {
    margin-top: 1.4rem;
    max-width: 48ch;
  }

  .faq__list {
    border-top: 1px solid var(--espresso);
  }

  .qa {
    border-bottom: 1px solid var(--cloud);
  }

  .qa__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.3rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--f-display);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    font-weight: 400;
    line-height: 1.3;
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__icon {
    position: relative;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--plum);
    transition: background-color 0.3s, rotate 0.4s var(--ease);
  }

  .qa__icon::before,
  .qa__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    translate: -50% -50%;
    background: var(--plum);
  }

  .qa__icon::after {
    rotate: 90deg;
  }

  .qa[open] .qa__icon {
    rotate: 45deg;
    background: var(--plum);
  }

  .qa[open] .qa__icon::before,
  .qa[open] .qa__icon::after {
    background: var(--cream);
  }

  .qa__a {
    padding-bottom: 1.4rem;
    max-width: 62ch;
    color: var(--mocha);
  }
</style>
