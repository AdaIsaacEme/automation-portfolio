---
// Diagram of the AI Sales Qualification Engine. Each group carries data-step
// matching the architecture list, so scrolling reveals it one piece at a time.
// Two layouts: a wide one for tablets/desktop and a tall one for phones, so the
// labels stay readable without sideways scrolling.
type Node = { x: number; y: number; w: number; h: number; label: string; sub?: string; strong?: boolean };
type Step = { paths: string[]; nodes: Node[] };
type Layout = { id: string; w: number; h: number; packet: string; steps: Step[] };

const wide: Layout = {
  id: "wide",
  w: 1100,
  h: 650,
  packet: "M95,330 L1000,330",
  steps: [
    {
      paths: ["M170,118 C215,118 205,330 250,330", "M170,330 L250,330", "M170,542 C215,542 205,330 250,330"],
      nodes: [
        { x: 20, y: 90, w: 150, h: 56, label: "WhatsApp" },
        { x: 20, y: 302, w: 150, h: 56, label: "Instagram DM" },
        { x: 20, y: 514, w: 150, h: 56, label: "Website chat" },
        { x: 250, y: 280, w: 190, h: 100, label: "GoHighLevel", sub: "Orchestration", strong: true },
      ],
    },
    { paths: ["M440,330 L490,330", "M610,330 L660,330"], nodes: [{ x: 490, y: 305, w: 120, h: 50, label: "Webhook" }] },
    { paths: [], nodes: [{ x: 660, y: 270, w: 200, h: 120, label: "FastAPI", sub: "Python · on Vercel", strong: true }] },
    { paths: ["M860,300 C895,300 885,110 920,110"], nodes: [{ x: 920, y: 70, w: 160, h: 80, label: "OpenAI", sub: "GPT + embeddings" }] },
    { paths: ["M860,330 L920,330"], nodes: [{ x: 920, y: 290, w: 160, h: 80, label: "Pinecone", sub: "RAG knowledge" }] },
    { paths: ["M860,360 C895,360 885,550 920,550"], nodes: [{ x: 920, y: 510, w: 160, h: 80, label: "Redis", sub: "Session memory" }] },
    {
      paths: ["M760,390 C760,590 600,580 440,580", "M345,540 L345,384"],
      nodes: [{ x: 250, y: 540, w: 190, h: 80, label: "CRM Pipeline", sub: "Updated + tasks ✓", strong: true }],
    },
  ],
};

const tall: Layout = {
  id: "tall",
  w: 360,
  h: 680,
  packet: "M180,40 L180,640",
  steps: [
    {
      paths: ["M60,60 C60,92 180,78 180,108", "M180,60 L180,108", "M300,60 C300,92 180,78 180,108"],
      nodes: [
        { x: 6, y: 16, w: 108, h: 44, label: "WhatsApp" },
        { x: 126, y: 16, w: 108, h: 44, label: "Instagram" },
        { x: 246, y: 16, w: 108, h: 44, label: "Web chat" },
        { x: 95, y: 110, w: 170, h: 68, label: "GoHighLevel", sub: "Orchestration", strong: true },
      ],
    },
    { paths: ["M180,178 L180,220", "M180,260 L180,304"], nodes: [{ x: 125, y: 222, w: 110, h: 38, label: "Webhook" }] },
    { paths: [], nodes: [{ x: 90, y: 306, w: 180, h: 74, label: "FastAPI", sub: "Python · on Vercel", strong: true }] },
    { paths: ["M180,380 C180,420 60,412 60,448"], nodes: [{ x: 6, y: 450, w: 108, h: 62, label: "OpenAI", sub: "GPT" }] },
    { paths: ["M180,380 L180,448"], nodes: [{ x: 126, y: 450, w: 108, h: 62, label: "Pinecone", sub: "RAG" }] },
    { paths: ["M180,380 C180,420 300,412 300,448"], nodes: [{ x: 246, y: 450, w: 108, h: 62, label: "Redis", sub: "Memory" }] },
    { paths: ["M180,512 L180,588"], nodes: [{ x: 95, y: 590, w: 170, h: 68, label: "CRM Pipeline", sub: "Updated + tasks ✓", strong: true }] },
  ],
};

const label =
  "Architecture: WhatsApp, Instagram and website chat feed GoHighLevel, which sends messages by webhook to a FastAPI service on Vercel. FastAPI uses OpenAI for reasoning, Pinecone for knowledge retrieval and Redis for memory, then updates the CRM pipeline.";
---

{
  [wide, tall].map((l) => (
    <svg class={`diagram diagram--${l.id}`} viewBox={`0 0 ${l.w} ${l.h}`} role="img" aria-label={label} data-packet-path={l.packet}>
      <defs>
        <marker id={`arrow-${l.id}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#CDBBDD" />
        </marker>
        <pattern id={`dots-${l.id}`} width="22" height="22" patternUnits="userSpaceOnUse">
          <circle cx="1.5" cy="1.5" r="1.2" fill="rgba(255,248,231,0.08)" />
        </pattern>
      </defs>
      <rect width={l.w} height={l.h} fill={`url(#dots-${l.id})`} />
      {l.steps.map((s, i) => (
        <g class="step" data-step={i}>
          {s.paths.map((d) => (
            <path class="edge" d={d} marker-end={`url(#arrow-${l.id})`} data-marker={`url(#arrow-${l.id})`} />
          ))}
          {s.nodes.map((n) => (
            <g class={`node ${n.strong ? "node--strong" : ""}`} data-node-box>
              <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.h > 50 ? 18 : n.h / 2} />
              <text x={n.x + n.w / 2} y={n.y + n.h / 2 + (n.sub ? -3 : 5)} text-anchor="middle" class="node__label">
                {n.label}
              </text>
              {n.sub && (
                <text x={n.x + n.w / 2} y={n.y + n.h / 2 + (l.id === "tall" ? 15 : 20)} text-anchor="middle" class="node__sub">
                  {n.sub}
                </text>
              )}
            </g>
          ))}
        </g>
      ))}
      <circle class="packet" r={l.id === "tall" ? 5 : 6} data-packet />
    </svg>
  ))
}

<style>
  .diagram {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .diagram--tall {
    display: none;
    max-width: 420px;
    margin-inline: auto;
  }

  /* Phones get the tall layout so labels stay readable without side-scrolling. */
  @media (max-width: 640px) {
    .diagram--wide {
      display: none;
    }

    .diagram--tall {
      display: block;
    }

    .diagram--tall .node__label {
      font-size: 15px;
    }

    .diagram--tall .node__sub {
      font-size: 11px;
    }
  }

  .edge {
    fill: none;
    stroke: var(--lilac);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .node rect {
    fill: rgb(255 248 231 / 0.06);
    stroke: rgb(205 187 221 / 0.6);
    stroke-width: 1.5;
  }

  .node--strong rect {
    fill: var(--plum);
    stroke: var(--lilac);
  }

  .node__label {
    font-family: var(--f-label);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.02em;
    fill: var(--cream);
  }

  .node__sub {
    font-family: var(--f-body);
    font-size: 13px;
    fill: var(--cloud);
  }

  .packet {
    fill: var(--cream);
    opacity: 0;
    filter: drop-shadow(0 0 6px var(--lilac));
  }

  .node {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>
