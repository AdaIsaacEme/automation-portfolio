---
// Diagram of the AI Sales Qualification Engine. Each group carries data-step
// matching the architecture list, so scrolling reveals it one piece at a time.
type Node = { x: number; y: number; w: number; h: number; label: string; sub?: string; strong?: boolean };

const steps: { paths: string[]; nodes: Node[] }[] = [
  {
    paths: [
      "M170,118 C215,118 205,330 250,330",
      "M170,330 L250,330",
      "M170,542 C215,542 205,330 250,330",
    ],
    nodes: [
      { x: 20, y: 90, w: 150, h: 56, label: "WhatsApp" },
      { x: 20, y: 302, w: 150, h: 56, label: "Instagram DM" },
      { x: 20, y: 514, w: 150, h: 56, label: "Website chat" },
      { x: 250, y: 280, w: 190, h: 100, label: "GoHighLevel", sub: "Orchestration", strong: true },
    ],
  },
  {
    paths: ["M440,330 L490,330", "M610,330 L660,330"],
    nodes: [{ x: 490, y: 305, w: 120, h: 50, label: "Webhook" }],
  },
  {
    paths: [],
    nodes: [{ x: 660, y: 270, w: 200, h: 120, label: "FastAPI", sub: "Python · on Vercel", strong: true }],
  },
  {
    paths: ["M860,300 C895,300 885,110 920,110"],
    nodes: [{ x: 920, y: 70, w: 160, h: 80, label: "OpenAI", sub: "GPT + embeddings" }],
  },
  {
    paths: ["M860,330 L920,330"],
    nodes: [{ x: 920, y: 290, w: 160, h: 80, label: "Pinecone", sub: "RAG knowledge" }],
  },
  {
    paths: ["M860,360 C895,360 885,550 920,550"],
    nodes: [{ x: 920, y: 510, w: 160, h: 80, label: "Redis", sub: "Session memory" }],
  },
  {
    paths: ["M760,390 C760,590 600,580 440,580", "M345,540 L345,384"],
    nodes: [{ x: 250, y: 540, w: 190, h: 80, label: "CRM Pipeline", sub: "Updated + tasks ✓", strong: true }],
  },
];
---

<svg
  class="diagram"
  viewBox="0 0 1100 650"
  role="img"
  aria-label="Architecture: WhatsApp, Instagram and website chat feed GoHighLevel, which sends messages by webhook to a FastAPI service on Vercel. FastAPI uses OpenAI for reasoning, Pinecone for knowledge retrieval and Redis for memory, then updates the CRM pipeline."
>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#CDBBDD"></path>
    </marker>
    <pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1.2" fill="rgba(255,248,231,0.08)"></circle>
    </pattern>
  </defs>
  <rect width="1100" height="650" fill="url(#dots)"></rect>

  {
    steps.map((s, i) => (
      <g class="step" data-step={i}>
        {s.paths.map((d) => (
          <path class="edge" d={d} marker-end="url(#arrow)" />
        ))}
        {s.nodes.map((n) => (
          <g class={`node ${n.strong ? "node--strong" : ""}`} data-node-box>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.h > 60 ? 20 : 28} />
            <text x={n.x + n.w / 2} y={n.y + n.h / 2 + (n.sub ? -4 : 6)} text-anchor="middle" class="node__label">
              {n.label}
            </text>
            {n.sub && (
              <text x={n.x + n.w / 2} y={n.y + n.h / 2 + 20} text-anchor="middle" class="node__sub">
                {n.sub}
              </text>
            )}
          </g>
        ))}
      </g>
    ))
  }
  <circle class="packet" r="6" data-packet></circle>
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Phones: keep labels readable and let the diagram scroll sideways. */
  @media (max-width: 700px) {
    .diagram {
      min-width: 620px;
    }

    :global(.arch__diagram),
    :global(.case__diagram) {
      overflow-x: auto;
    }
  }

  .edge {
    fill: none;
    stroke: var(--lilac);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .node rect {
    fill: rgb(255 248 231 / 0.06);
    stroke: rgb(205 187 221 / 0.6);
    stroke-width: 1.5;
  }

  .node--strong rect {
    fill: var(--plum);
    stroke: var(--lilac);
  }

  .node__label {
    font-family: var(--f-label);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.02em;
    fill: var(--cream);
  }

  .node__sub {
    font-family: var(--f-body);
    font-size: 13px;
    fill: var(--cloud);
  }

  .packet {
    fill: var(--cream);
    opacity: 0;
    filter: drop-shadow(0 0 6px var(--lilac));
  }

  .node {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>
