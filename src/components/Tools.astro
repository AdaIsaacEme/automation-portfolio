---
import { Image } from "astro:assets";
import { toolGroups, toolsIntro } from "../data/site";
import { shot } from "../lib/images";
---

<section id="tools" class="tools section" data-section>
  <div class="wrap tools__head">
    <p class="label"><span class="num">03</span> Tools & Stack</p>
    <h2 class="h2" data-split>The <em>stack</em> behind the systems</h2>
    <p class="tools__intro muted" data-fade-up>{toolsIntro}</p>
  </div>

  <div class="tools__rows">
    {
      toolGroups.map((group, gi) => (
        <div class="tools__row">
          <h3 class="tools__group wrap">
            <span class="tools__group-count">{String(group.tools.length).padStart(2, "0")}</span>
            {group.title}
          </h3>
          <div class="marquee">
            <div class="marquee__track" data-marquee data-speed={gi % 2 ? "-0.45" : "0.45"} data-velocity>
              {[0, 1, 2].map((copy) => (
                <ul class="marquee__list" aria-hidden={copy > 0 ? "true" : undefined}>
                  {group.tools.map((t) => (
                    <li class="tool">
                      <span class="tool__logo">
                        <Image src={shot(t.logo)} alt={copy === 0 ? `${t.name} logo` : ""} width={120} height={120} />
                      </span>
                      <span class="tool__name">{t.name}</span>
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .tools {
    overflow: clip;
  }

  .tools__head {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .tools__intro {
    margin-top: 1.5rem;
    max-width: 52ch;
    font-size: 1.1rem;
  }

  .tools__rows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
  }

  .tools__group {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 1rem;
    font-family: var(--f-label);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mocha);
  }

  .tools__group-count {
    color: var(--plum);
  }

  .marquee {
    overflow: hidden;
    padding-block: 0.4rem;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  /* Reduced motion / no JS: let people scroll the row by hand instead */
  :global(html:not(.motion)) .marquee {
    overflow-x: auto;
    mask-image: none;
  }

  .marquee__list {
    display: flex;
    flex-shrink: 0;
    gap: 1rem;
    padding-right: 1rem;
  }

  .tool {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 1.6rem 0.7rem 0.7rem;
    border-radius: 999px;
    background: var(--coconut);
    border: 1px solid var(--khaki);
    white-space: nowrap;
    transition:
      background-color 0.35s,
      color 0.35s,
      transform 0.5s var(--ease);
  }

  .tool:hover {
    background: var(--espresso);
    color: var(--cream);
    transform: translateY(-4px) rotate(-1.5deg);
  }

  .tool__logo {
    width: clamp(52px, 6vw, 72px);
    height: clamp(52px, 6vw, 72px);
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    padding: 10px;
    flex-shrink: 0;
  }

  .tool__logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tool__name {
    font-family: var(--f-display);
    font-size: clamp(1.2rem, 2.2vw, 1.9rem);
    font-weight: 380;
    letter-spacing: -0.01em;
  }
  /* Phones: smaller chips so more tools fit on screen at once. */
  @media (max-width: 640px) {
    .marquee__list {
      gap: 0.5rem;
      padding-right: 0.5rem;
    }

    .tool {
      gap: 0.5rem;
      padding: 0.3rem 0.85rem 0.3rem 0.3rem;
    }

    .tool__logo {
      width: 34px;
      height: 34px;
      padding: 5px;
    }

    .tool__name {
      font-size: 0.95rem;
    }
  }
</style>
